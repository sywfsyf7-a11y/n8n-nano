            "Service": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Service', 'اسم الخدمة المطلوبة', 'string') }}",
            "Amount_JOD": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Amount_JOD', 'السعر بالدينار الأردني كرقم فقط', 'number') }}",
            "Status": "Confirmed",
            "Notes": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Notes', 'أي ملاحظات إضافية من العميل', 'string') }}"
          }
        }
